<?xml version="1.0" encoding="utf-8"?>
<!--
    ARIA App Icon Background
    ========================
    A deep purple to indigo gradient — matches the app's color scheme.
    This replaces the default plain green Android background.

    The gradient goes from the primary purple (#6C63FF) at top-left
    to a deeper dark blue (#0F0E17) at bottom-right.
    This looks modern and intentional, not like a default icon.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#6C63FF"
        android:centerColor="#3A3580"
        android:endColor="#0F0E17" />
</shape>