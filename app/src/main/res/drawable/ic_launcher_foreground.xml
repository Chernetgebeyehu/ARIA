<?xml version="1.0" encoding="utf-8"?>
<!--
    ARIA App Icon Foreground
    ========================
    A clean, modern "A" letterform with a sound wave arc above it.
    The arc represents ARIA listening — voice / AI / audio.

    Design thinking:
    - "A" for ARIA, large and centered
    - Arc above the A = listening / voice wave
    - Two small dots at the ends of the arc = signal strength / activity
    - White on transparent — the gradient background shows through
    - Simple enough to read at 48x48dp, distinctive at 512x512

    This is drawn in a 108x108 viewBox (Android adaptive icon standard).
    The "safe zone" is the inner 72x72 — all important elements are inside it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sound wave arc — drawn above the letter A -->
    <!-- Left arc segment -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M 32,42 Q 40,28 54,28 Q 68,28 76,42" />

    <!-- Outer arc — larger wave -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.6"
        android:strokeLineCap="round"
        android:pathData="M 25,47 Q 33,26 54,26 Q 75,26 83,47" />

    <!-- Left dot at end of inner arc -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 32,42 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />

    <!-- Right dot at end of inner arc -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 76,42 m -2.5,0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0" />

    <!-- Letter A — bold, centered -->
    <!-- Left leg of A -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,50 L 36,82 L 42,82 L 54,60 Z" />

    <!-- Right leg of A -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,50 L 72,82 L 66,82 L 54,60 Z" />

    <!-- Crossbar of A -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 44,72 L 64,72 L 64,67 L 44,67 Z" />

</vector>