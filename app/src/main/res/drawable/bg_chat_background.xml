<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep dark base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A14"/>
        </shape>
    </item>

    <!-- Subtle gradient overlay — top purple glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="#1A1040"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Bottom accent glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.5"
                android:centerY="1.0"
                android:startColor="#0D1A2E"
                android:endColor="#00000000"/>
        </shape>
    </item>

</layer-list>