<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_chat_background"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="8dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/bg_floating_button"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARIA"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOnlineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Online · Gemini 2.5"
                android:textColor="@color/online_green"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnScreenScan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_card"
            android:src="@drawable/ic_assistant"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="Scan screen" />

    </LinearLayout>

    <!-- MESSAGES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_chat_background"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="12dp" />

    <!-- INPUT BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_floating_button"
            android:src="@drawable/ic_mic"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Voice input" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="Message ARIA..."
            android:inputType="text"
            android:imeOptions="actionSend"
            android:paddingHorizontal="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_floating_button"
            android:src="@drawable/ic_send"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Send" />

    </LinearLayout>

</LinearLayout>