<file path="app/src/main/java/com/cherinet/aria/automation/ActionRouter.kt">
package com.cherinet.aria.automation

import android.content.Context
import com.cherinet.aria.ai.AiManager
import org.json.JSONObject

/**
 * ActionRouter: Takes the AI's JSON response and executes the right action.
 *
 * Think of this like a post office:
 * - The AI writes a letter (JSON response)
 * - ActionRouter reads the address (action type)
 * - And delivers it to the right handler (AppController function)
 *
 * What changed from before:
 * - Now returns BOTH the spoken response AND the action result
 * - Handles the new "spoken" field in AI responses
 * - Better error messages
 */
class ActionRouter(
    private val context: Context,
    private val appController: AppController
) {

    data class RouteResult(
        val spokenText: String,    // What ARIA says out loud
        val displayText: String,   // What shows in the chat
        val actionExecuted: Boolean = false,
        val actionType: String = ""
    )

    suspend fun handle(
        input: String,
        aiManager: AiManager
    ): RouteResult {

        val rawResponse = aiManager.sendMessage(input)

        return try {
            val json = JSONObject(rawResponse)

            when (json.getString("type")) {

                "chat" -> {
                    val text = json.getString("text")
                    RouteResult(spokenText = text, displayText = text)
                }

                "action" -> {
                    // Get what ARIA wants to say while doing the action
                    val spoken = json.optString("spoken", "")
                    val actions = json.getJSONArray("actions")
                    val resultLines = mutableListOf<String>()

                    for (i in 0 until actions.length()) {
                        val action = actions.getJSONObject(i)
                        val tool = action.getString("tool")
                        val value = action.optString("value", "")
                        resultLines.add(execute(tool, value))
                    }

                    val actionResult = resultLines.joinToString("\n")

                    // If AI gave a spoken response, use that. Otherwise use action result.
                    val finalSpoken = spoken.ifBlank { actionResult }

                    RouteResult(
                        spokenText = finalSpoken,
                        displayText = actionResult,
                        actionExecuted = true,
                        actionType = if (actions.length() > 0)
                            actions.getJSONObject(0).optString("tool") else ""
                    )
                }

                "security" -> {
                    val text = json.optString("text", "Security analysis complete.")
                    val verdict = json.optString("verdict", "unknown")
                    val icon = when (verdict) {
                        "safe" -> "✅"
                        "warning" -> "⚠️"
                        "danger" -> "🚨"
                        else -> "🔍"
                    }
                    val display = "$icon $text"
                    RouteResult(spokenText = text, displayText = display)
                }

                else -> {
                    RouteResult(
                        spokenText = "I got an unexpected response. Please try again.",
                        displayText = "⚠️ Unknown response format"
                    )
                }
            }

        } catch (e: Exception) {
            // If JSON parsing fails, the AI returned plain text
            // Just show it as a chat message
            RouteResult(
                spokenText = rawResponse,
                displayText = rawResponse
            )
        }
    }

    private fun execute(tool: String, value: String): String {
        return when (tool) {

            "open_app" -> {
                if (appController.openApp(value)) "✅ Opening $value!"
                else "❌ Couldn't find \"$value\". Is it installed?"
            }

            "search" -> {
                appController.search(value)
                "🔍 Searching for: $value"
            }

            "call" -> {
                // Note: ChatActivity handles contact lookup before reaching here
                // for voice commands. This handles AI-routed calls.
                appController.makeCall(value)
                "📞 Calling $value..."
            }

            "sms" -> {
                appController.sendSms(value)
                "✉️ Opening message to $value..."
            }

            "alarm" -> {
                // Value is like "7:00am" or "14:30"
                "⏰ Opening alarm app to set $value"
                // Note: detailed alarm parsing stays in ChatActivity for now
                // Phase 2 will move it here
            }

            "timer" -> {
                "⏱️ Setting timer for $value"
            }

            "settings" -> {
                appController.openSettings()
                "⚙️ Opening settings"
            }

            "open_url" -> {
                appController.openUrl(value)
                "🌐 Opening $value"
            }

            else -> "⚠️ I don't know how to do: $tool"
        }
    }
}
