package com.cherinet.aria.ai

/**
 * OpenRouter model registry.
 *
 * OpenRouter lets you use many AI models from one API.
 * Each model has different strengths:
 * - Fast models: good for quick commands
 * - Smart models: good for complex reasoning
 * - Free models: good for testing (limited usage)
 *
 * Find more models at: openrouter.ai/models
 */
object OpenRouterModels {

    // ═══ FREE MODELS (no cost, good for testing) ═══

    // Google's Gemma 3 — good general purpose, free tier
    const val GEMMA_3_4B = "google/gemma-3-4b-it:free"

    // Meta's Llama 3 8B — fast and capable, free tier
    const val LLAMA_3_8B = "meta-llama/llama-3-8b-instruct:free"

    // Microsoft Phi-3 — small but surprisingly smart, free
    const val PHI_3_MINI = "microsoft/phi-3-mini-128k-instruct:free"

    // ═══ PAID MODELS (better quality, costs tokens) ═══

    // Google's Gemma 3 27B — much smarter than 4B
    const val GEMMA_3_27B = "google/gemma-3-27b-it"

    // Mistral 7B — great balance of speed and quality
    const val MISTRAL_7B = "mistralai/mistral-7b-instruct"

    // Claude Haiku — fast, cheap Anthropic model
    const val CLAUDE_HAIKU = "anthropic/claude-3-haiku"

    // ═══ DEFAULTS ═══

    // Used when no model is specified
    // Change this to whatever works best for you
    const val DEFAULT = GEMMA_3_4B

    // Used for complex reasoning tasks (agent planning)
    const val SMART = CLAUDE_HAIKU

    // Used for quick, simple commands
    const val FAST = LLAMA_3_8B

    /**
     * All available models with descriptions.
     * Used in settings screen to let user pick a model.
     */
    val ALL_MODELS = listOf(
        ModelInfo(GEMMA_3_4B, "Gemma 3 4B (Free)", "Fast, free, good for commands"),
        ModelInfo(LLAMA_3_8B, "Llama 3 8B (Free)", "Good reasoning, free tier"),
        ModelInfo(PHI_3_MINI, "Phi-3 Mini (Free)", "Small but smart, free"),
        ModelInfo(GEMMA_3_27B, "Gemma 3 27B", "Smarter, costs tokens"),
        ModelInfo(MISTRAL_7B, "Mistral 7B", "Great quality/speed balance"),
        ModelInfo(CLAUDE_HAIKU, "Claude Haiku", "Best quality, costs tokens")
    )

    data class ModelInfo(
        val id: String,
        val displayName: String,
        val description: String
    )
}
